[
{"cat": "motiv", "text": "حاسب نفسك برفق، ثم قم وأكمل.", "source": "عبارة من تأليف التطبيقة"},
{"cat": "motiv", "text": "النية الصالحة تجعل العمل العادي عظيم المعنى.", "source": "عبارة من تأليف التطبيقة"},
{"cat": "motiv", "text": "لا تؤجل صلة من تحب.", "source": "عبارة من تأليف التطبيقة"},
{"cat": "motiv", "text": "إنجاز صغير اليوم خير من خطة كبيرة مؤجلة.", "source": "عبارة من تأليف التطبيقة"},
{"cat": "motiv", "text": "هدوؤك قوة.", "source": "عبارة من تأليف التطبيقة"},
{"cat": "motiv", "text": "تعلّم شيئا واحدا جديدا كل يوم.", "source": "عبارة من تأليف التطبيقة"},
{"cat": "motiv", "text": "سامح، فقلبك أولى بالراحة.", "source": "عبارة من تأليف التطبيقة"},
{"cat": "motiv", "text": "ما ضاع جهد صادق.", "source": "عبارة من تأليف التطبيقة"},
{"cat": "motiv", "text": "ابتسامتك صدقة على يومك ويوم غيرك.", "source": "عبارة من تأليف التطبيقة"},
{"cat": "motiv", "text": "إذا ثقل الطريق، فخفف الحمل ولا تترك السير.", "source": "عبارة من تأليف التطبيقة"},
